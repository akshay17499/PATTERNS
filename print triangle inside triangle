#include<stdio.h>

int main()
{
    printf("enter num : ");
    int num;
    scanf("%d",&num);
    int k=1;
    for(int i=1;i<=num;i++)
    {
        for(int j = 1;j<=num;j++)
        {
            if(i==1||j==1||i+j == num+1)
            {
                printf("%d ",k++);
            }
            else if(i+j<num+1){
                printf("_");
            }
        }
        printf("\n");
    }
}
