#include<stdio.h>

int main()
{
    printf("enter num : ");
    int size;
    scanf("%d",&size);
    int k=5;
    for(int i=1;i<=2*size-1;i++)
    {    
        for(int j=1;j<=size;j++)
        {
            if(i<=size&&j<=i)
            {
                printf("%d ",k++);
            }
            else if(i>size&&i+j<=2*size)
            printf("%d ",k++);
        }
        printf("\n");
        if(i<size)
        {
            k=k-i-1;
        }
        else
        k = i%5+2;
    }
   
}
